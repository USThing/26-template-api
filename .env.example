# Local development needs no .env; it uses an ephemeral MongoDB and demo users.
# For Docker Compose, copy this file to .env. These are LOCAL EXAMPLE tokens:
# replace both with randomly generated secrets before any real deployment.
# Generate one with: bun -e 'console.log(crypto.randomUUID()+crypto.randomUUID())'
AUTH_USERS='[{"username":"alice","name":"Alice","token":"alice-local-example-token-2026"},{"username":"bob","name":"Bob","token":"bob-local-example-token-2026"}]'
AUTH_SKIP=false

# Optional existing database for native development (Compose overrides this).
# MONGO_URI=mongodb://127.0.0.1:27017/custom-timetable-api
