{
  "type": "module",
  "name": "custom-timetable-api",
  "version": "1.0.0",
  "private": true,
  "description": "Per-user custom timetable events with iCalendar export.",
  "main": "src/app.ts",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "test": "bun test --coverage --timeout=60000 test",
    "compile": "tsc && tsc -p test/tsconfig.json",
    "check": "biome ci .",
    "lint": "biome lint --write .",
    "fmt": "biome format --write ."
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "keywords": [],
  "author": "Weilin Du",
  "license": "MIT",
  "dependencies": {
    "@fastify/autoload": "^6.5.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/mongodb": "^10.0.1",
    "@fastify/sensible": "^6.0.5",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@scalar/fastify-api-reference": "^1.68.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "fastify": "^5.12.4",
    "fastify-plugin": "^6.0.0",
    "mongodb": "^7.6.0",
    "typebox": "^1.3.31"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@types/bun": "^1.4.2",
    "ical.js": "^2.2.1",
    "mongodb-memory-server": "^11.2.0",
    "typescript": "7.0.2"
  }
}
